class MainActivity : ComponentActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        enableEdgeToEdge()
        setContent {
            LemonadeTheme {
                Surface(modifier = Modifier.fillMaxSize(), color = Color(0xFFFDF6E3)) {
                    LemonApp()
                }
            }
        }
    }
}

@Composable
fun LemonApp() {
    var count by remember { mutableStateOf(1) }

    val imgResource = when (count) {
        1 -> R.drawable.lemon_tree
        2 -> R.drawable.lemon_squeeze
        3 -> R.drawable.lemon_drink
        4 -> R.drawable.lemon_restart
        else -> R.drawable.lemon_tree
    }

    val strResource = when (count) {
        1 -> R.string.lemon_tree
        2 -> R.string.tap_on_lemon
        3 -> R.string.drink
        4 -> R.string.restart
        else -> R.string.lemon_tree
    }

    Column(
        horizontalAlignment = Alignment.CenterHorizontally,
        verticalArrangement = Arrangement.Center,
        modifier = Modifier
            .fillMaxSize()
            .background(Color(0xFFFDF6E3)) // Light yellowish background
            .padding(16.dp)
    ) {
        // Title
        Text(
            text = stringResource(R.string.app_name),
            fontSize = 24.sp,
            color = Color(0xFF3E2723),
            modifier = Modifier
                .background(Color(0xFFFFEB3B), shape = RoundedCornerShape(8.dp))
                .padding(horizontal = 24.dp, vertical = 12.dp)
                .clip(RoundedCornerShape(8.dp))
        )

        Spacer(modifier = Modifier.height(24.dp))

        // Image inside Card for better UI
        Card(
            shape = RoundedCornerShape(16.dp),
            elevation = CardDefaults.elevatedCardElevation(6.dp),
            modifier = Modifier
                .clickable {
                    count = if (count < 4) count + 1 else 1
                }
        ) {
            Image(
                painter = painterResource(id = imgResource),
                contentDescription = stringResource(strResource),
                modifier = Modifier
                    .padding(16.dp)
                    .size(200.dp)
            )
        }

        Spacer(modifier = Modifier.height(24.dp))

        // Instruction Text
        Text(
            text = stringResource(strResource),
            fontSize = 20.sp,
            color = Color(0xFF795548),
            modifier = Modifier.padding(8.dp)
        )
    }
}

